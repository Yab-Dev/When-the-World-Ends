  m_Script: {fileID: 11500000, guid: 0b5d57967b0e5404a8749fa2026a059d, type: 3}
  m_Name: TutorialIntro
  m_EditorClassIdentifier: 
  hasSkipButton: 1
  textBoxes:
  - message: Hello? Hello do you copy?
    buttonText: Hello?
  - message: Ah good. I'll keep this brief. See that timer in the top right? That's
      how long we have until this blasted AI takes over the world.
    buttonText: What?
  - message: Things are grim, yes. Good news, you can stall it by taking out key
      AI targets. You're in command of the world's troops after all.
    buttonText: Ok...
  - message: By now you should see an orange dot on the map. You can drag open windows
      around if you can't find it. Click on it to view your troops in that continent
      and what you'll be up against.
    buttonText: 
